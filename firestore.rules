rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow reading user profiles (needed for sign-in email lookup)
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /subscription/{doc} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only Cloud Functions (Admin SDK) can write
      }
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['theme', 'items', 'voteCounts', 'targetTotalVotes', 'createdByName', 'createdByVoterId', 'createdAt'])
        && request.resource.data.theme is string
        && request.resource.data.items is list;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voteCounts', 'lastVoteAt', 'completedAt']);
      allow delete: if false;

      match /events/{eventId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['optionIndex', 'voterId', 'voterName', 'votedAt']);
        allow update, delete: if false;
      }
    }
  }
}
