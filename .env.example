# Copy to `.env` in the project root and fill in from
# Firebase Console → Project settings → General → Your apps → Web app.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# GameTap / Firebase Realtime Database URL (required for Retrieve tab):
# Firebase Console → Build → Realtime Database → copy URL, e.g.
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
# Optional alias (same value; wins over FIREBASE_DATABASE_URL if both set):
# EXPO_PUBLIC_GAMETAP_RTDB_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
